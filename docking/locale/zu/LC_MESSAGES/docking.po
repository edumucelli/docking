#: docking/core/tips.py:57
msgid "Open the dock menu from anywhere"
msgstr "Vula imenyu yedokhi noma yikuphi"

#: docking/core/tips.py:59
msgid ""
"Hold Ctrl and right-click anywhere on the shelf to open the dock menu. This "
"is the quickest path to Preferences, Applets, Diagnostics, and Quit when "
"there is no empty space near the icons."
msgstr ""
"Bamba u-Ctrl bese uchofoza kwesokudla noma yikuphi eshalofini ukuze uvule "
"imenyu yedokhi. Lena indlela eshesha kakhulu eya Okuthandwayo, Ama-Applets, "
"Ukuxilongwa, kanye Nokuyeka lapho singekho isikhala esingenalutho eduze "
"kwezithonjana."

#: docking/core/tips.py:67
msgid "Start with Preferences"
msgstr "Qala Ngezintandokazi"

#: docking/core/tips.py:69
msgid ""
"Use Preferences to adjust position, monitor behavior, icon size, zoom, "
"hiding, themes, previews, tooltips, and click actions. It is the best first "
"stop when the dock does not feel quite right."
msgstr ""
"Sebenzisa Okuncamelayo ukuze ulungise indawo, ugade ukuziphatha, usayizi "
"wesithonjana, ukusondeza, ukucasha, amatimu, ukuhlola kuqala, amathiphu, "
"kanye nokuchofoza izenzo. Yindawo yokuqala ehamba phambili lapho idokhi "
"ingazizwa ilungile."

#: docking/core/tips.py:76
msgid "Add applets from the dock menu"
msgstr "Engeza ama-apula kumenyu yedokhi"

#: docking/core/tips.py:78
msgid ""
"Right-click the shelf background and choose Add Applet to add launchers, "
"system status, media controls, productivity helpers, and small utility tools "
"directly to the dock."
msgstr ""
"Chofoza kwesokudla ingemuva leshelufu bese ukhetha Engeza i-Applet ukuze "
"wengeze iziqalisi, isimo sesistimu, izilawuli zemidiya, izisizi zokukhiqiza, "
"namathuluzi amancane awusizo ngqo kudokhi."

#: docking/core/tips.py:85
msgid "Use separators for organization"
msgstr "Sebenzisa izihlukanisi zenhlangano"

#: docking/core/tips.py:87
msgid ""
"Right-click where a divider should go and choose Add Separator. Separators "
"make it easier to keep pinned apps, folders, and applets in clear groups."
msgstr ""
"Chofoza kwesokudla lapho isihlukanisi kufanele siye khona bese ukhetha "
"Engeza Isihlukanisi. Izihlukanisi zenza kube lula ukugcina izinhlelo "
"zokusebenza eziphiniwe, amafolda, nama-applet emaqenjini acacile."

#: docking/core/tips.py:94
msgid "Pin running apps"
msgstr "Phina izinhlelo zokusebenza ezisebenzayo"

#: docking/core/tips.py:96
msgid ""
"Right-click a running app and choose Keep in Dock. The launcher will stay "
"available after the app closes, so you can start it again with one click."
msgstr ""
"Chofoza kwesokudla kuhlelo lokusebenza olusebenzayo bese ukhetha Gcina "
"kuDokhi. Isiqalisi sizohlala sitholakala ngemva kokuvalwa kohlelo "
"lokusebenza, ukuze ukwazi ukusiqala futhi ngokuchofoza okukodwa."

#: docking/core/tips.py:103
msgid "Remove pinned items quickly"
msgstr "Susa izinto eziphiniwe ngokushesha"

#: docking/core/tips.py:105
msgid ""
"Right-click a pinned item and choose Remove from Dock, or drag unlocked "
"items off the dock. Removing a launcher does not uninstall the application "
"or delete your files."
msgstr ""
"Chofoza kwesokudla into ephiniwe bese ukhetha Susa kudokhi, noma hudula "
"izinto ezingakhiyiwe uzikhiphe kudokhi. Ukukhipha isiqalisi akukhiphi uhlelo "
"lokusebenza noma kususe amafayela akho."

#: docking/core/tips.py:112
msgid "Drop items onto the dock"
msgstr "Beka izinto kudokhi"

#: docking/core/tips.py:114
msgid ""
"Drag applications, .desktop files, files, folders, and AppImages onto "
"Docking to pin them. Dropped folders become folder stacks, and dropped "
"AppImages can get their own launcher."
msgstr ""
"Hudula izinhlelo zokusebenza, amafayela edeskithophu, amafayela, amafolda, "
"ne-AppImages ku-Docking ukuze ukuphine. Amafolda awile aba izitaki zefolda, "
"futhi i-AppImages eyehlisiwe ingathola isiqalisi sazo."

#: docking/core/tips.py:121
msgid "Open files with dock apps"
msgstr "Vula amafayela ngezinhlelo zokusebenza zedokhi"

#: docking/core/tips.py:123
msgid ""
"Drag a file onto an application icon to open it with that app. This is "
"useful when the file manager would otherwise choose the wrong default "
"application."
msgstr ""
"Hudula ifayela kusithonjana sohlelo lokusebenza ukuze ulivule ngalolo hlelo "
"lokusebenza. Lokhu kuyasiza uma umphathi wefayela engakhetha uhlelo "
"oluzenzakalelayo olungalungile."

#: docking/core/tips.py:130
msgid "Use folder stacks"
msgstr "Sebenzisa izitaki zefolda"

#: docking/core/tips.py:132
msgid ""
"Pin a folder and click it from the dock to browse its contents without "
"opening a file manager first. It works well for common places like "
"Downloads, Projects, and screenshots."
msgstr ""
"Phina ifolda bese uyichofoza usuka kudokhi ukuze uphequlule okuqukethwe "
"kwayo ngaphandle kokuvula imenenja yefayela kuqala. Isebenza kahle "
"ezindaweni ezijwayelekile ezifana nokulandwayo, amaphrojekthi, nezithombe-"
"skrini."

#: docking/core/tips.py:139
msgid "Tune folder stack behavior"
msgstr "Shuna ukuziphatha kwesitaki sefolda"

#: docking/core/tips.py:141
msgid ""
"Right-click a pinned folder to sort contents, show hidden files, or "
"customize its icon. These options let each stack behave like the folder it "
"represents."
msgstr ""
"Chofoza kwesokudla ifolda ephiniwe ukuze uhlele okuqukethwe, ubonise "
"amafayela afihliwe, noma wenze ngokwezifiso isithonjana sayo. Lezi zinketho "
"zivumela isitaki ngasinye siziphathe njengefolda esiyimele."

#: docking/core/tips.py:148
msgid "Keep mounted devices within reach"
msgstr "Gcina amadivayisi afakiwe eduze"

#: docking/core/tips.py:150
msgid ""
"Add the Devices applet to browse every mounted device in a live stack. "
"Mounts appear and disappear automatically, and Preferences -> Behavior "
"controls whether stacks open on hover or click."
msgstr "Engeza i-applet Yamadivayisi ukuze uphenye yonke idivayisi efakiwe "
"kusitaki esibukhoma. Okufakiwe kuvela futhi kunyamalale ngokuzenzakalelayo, "
"futhi Izinketho -> Ukuziphatha kulawula ukuthi izitaki zivuleka "
"ngokuhambahamba noma ngokuchofoza."

#: docking/core/tips.py:158
msgid "Follow news sources by country"
msgstr "Landela imithombo yezindaba ngezwe"

#: docking/core/tips.py:160
msgid ""
"Add the News applet, choose a country, and select a publication or edition. "
"Scroll through its latest headlines, or add more sources and switch between "
"them from the applet menu."
msgstr "Engeza i-applet Yezindaba, khetha izwe, bese ukhetha ushicilelo noma "
"uhlelo. Skrola ezihlokweni zayo zakamuva, noma engeza eminye imithombo futhi "
"ushintshe phakathi kwayo kusuka kumenyu ye-applet."

#: docking/core/tips.py:167
msgid "Customize pinned icons"
msgstr "Enza ngendlela oyifisayo izithonjana eziphiniwe"

#: docking/core/tips.py:169
msgid ""
"Right-click a pinned app, file, or folder and use Icon -> Choose From File. "
"Custom icons are stored in Docking's config, so the original desktop file or "
"file on disk is left untouched."
msgstr ""
"Chofoza kwesokudla uhlelo lokusebenza oluphiniwe, ifayela, noma ifolda bese "
"usebenzisa Isithonjana -> Khetha Kufayela. Izithonjana ezenziwe ngokwezifiso "
"zigcinwa ku-Docking's config, ngakho ifayela lokuqala ledeskithophu noma "
"ifayela elikwidiski lishiywa lingathintwa."

#: docking/core/tips.py:176
msgid "Use the Applications applet search"
msgstr "Sebenzisa usesho lwe-applet yezinhlelo zokusebenza"

#: docking/core/tips.py:178
msgid ""
"Add the Applications applet, open it, and type to filter installed apps. It "
"gives you a compact launcher menu without leaving the dock."
msgstr ""
"Engeza i-applet yezinhlelo zokusebenza, yivule, bese uthayipha ukuze uhlunge "
"izinhlelo zokusebenza ezifakiwe. Ikunikeza imenyu yesiqalisi esihlangene "
"ngaphandle kokushiya idokhu."

#: docking/core/tips.py:185
msgid "Drag apps straight to the dock"
msgstr "Hudula izinhlelo ziqonde ku-dock"

#: docking/core/tips.py:187
msgid ""
"Open the Applications applet and drag any application from its menu onto the "
"shelf. Drop it where you want its launcher to stay in the dock."
msgstr "Vula i-applet Yezinhlelo bese uhudula noma yiluphi uhlelo kusuka "
"kumenyu yayo ukuya eshelfini. Yidedele lapho ufuna isiqalisi sayo sihlale "
"khona ku-dock."

#: docking/core/tips.py:194
msgid "Keep WhatsApp in the dock"
msgstr "Gcina i-WhatsApp ku-dock"

#: docking/core/tips.py:196
msgid ""
"Add the WhatsApp applet for a persistent WhatsApp Web window, desktop "
"notifications, and an unread-message badge. Closing the window hides it "
"without signing out."
msgstr "Engeza i-applet ye-WhatsApp ukuze ube newindiwe ye-WhatsApp Web "
"ehlala ikhona, izaziso zedeskithophu, nebheji yemilayezo engafundiwe. "
"Ukuvala iwindiwe kuyifihla ngaphandle kokuphuma."

#: docking/core/tips.py:203
msgid "Use Run Application like Alt+F2"
msgstr "Sebenzisa uhlelo lokusebenza lwe-Run njengo-Alt+F2"

#: docking/core/tips.py:205
msgid ""
"Add Run Application to launch commands, apps, and terminal commands from the "
"dock. As you type, matching applications are shown so you can launch by name "
"or run a standalone command."
msgstr ""
"Engeza uhlelo lokusebenza lwe-Run ukuze uqalise imiyalo, izinhlelo "
"zokusebenza, nemiyalo yetheminali ukusuka kudokhi. Njengoba uthayipha, "
"izinhlelo zokusebenza ezifanayo ziyaboniswa ukuze ukwazi ukuqalisa ngamagama "
"noma usebenzise umyalo ozimele."

#: docking/core/tips.py:212
msgid "Use window previews"
msgstr "Sebenzisa ukubuka kuqala kwewindi"

#: docking/core/tips.py:214
msgid ""
"Hover running apps to inspect open windows before switching. Previews help "
"when one application has several windows open."
msgstr ""
"Hambisa phansi izinhlelo zokusebenza ezisebenzayo ukuze uhlole amawindi "
"avuliwe ngaphambi kokushintsha. Ukuhlola kuqala kuyasiza lapho uhlelo "
"lokusebenza olulodwa lunamawindi amaningana avuliwe."

#: docking/core/tips.py:220
msgid "Choose your click behavior"
msgstr "Khetha ukuziphatha kwakho ngokuchofoza"

#: docking/core/tips.py:222
msgid ""
"Preferences -> Behavior lets left click toggle, cycle, or focus the most "
"recent window. Pick the behavior that matches how you switch between running "
"applications."
msgstr ""
"Okuncanyelwayo -> Ukuziphatha kuvumela ukuchofoza kwesokunxele ukuguqula, "
"ukujikeleza, noma kugxilise iwindi lakamuva kakhulu. Khetha ukuziphatha "
"okufana nendlela oshintsha ngayo phakathi kwezinhlelo zokusebenza "
"ezisebenzayo."

#: docking/core/tips.py:229
msgid "Ctrl-click opens a new window"
msgstr "Ukuchofoza u-Ctrl kuvula iwindi elisha"

#: docking/core/tips.py:231
msgid ""
"Hold Ctrl while clicking an app icon to launch another window. This works "
"even when the app is already running and a normal click would focus it."
msgstr ""
"Bamba u-Ctrl ngenkathi uchofoza isithonjana sohlelo lokusebenza ukuze "
"uqalise elinye iwindi. Lokhu kusebenza noma ngabe uhlelo lokusebenza "
"seluvele luyasebenza futhi ukuchofoza okuvamile kuzogxila kulo."

#: docking/core/tips.py:238
msgid "Use Clock as a calendar"
msgstr "Sebenzisa iwashi njengekhalenda"

#: docking/core/tips.py:240
msgid ""
"Left-click the Clock applet to open the same calendar popup as the Calendar "
"applet. Use Clock when you want the time and calendar in one dock item."
msgstr "Chofoza kwesokunxele i-applet yewashi ukuze uvule isibonakaliso "
"sekhalenda esifanayo ne-applet yekhalenda. Sebenzisa iwashi uma ufuna "
"isikhathi nekhalenda entweni eyodwa ye-dock."

#: docking/core/tips.py:247
msgid "Use app right-click menus"
msgstr "Sebenzisa amamenyu okuchofoza kwesokudla kohlelo lokusebenza"

#: docking/core/tips.py:249
msgid ""
"Right-click apps for desktop actions, open windows, recent documents, "
"pinning, and close actions. Many apps expose useful shortcuts there, such as "
"opening a private window or composing a new message."
msgstr ""
"Chofoza kwesokudla izinhlelo zokusebenza zezenzo zedeskithophu, vula "
"amawindi, imibhalo yakamuva, ukuphina, nokuvala izenzo. Izinhlelo "
"zokusebenza eziningi zidalula izinqamuleli eziwusizo lapho, njengokuvula "
"iwindi eliyimfihlo noma ukubhala umlayezo omusha."

#: docking/core/tips.py:257
msgid "Use Recent Files"
msgstr "Sebenzisa Amafayela Akamuva"

#: docking/core/tips.py:259
msgid ""
"Add the Recent Files applet to jump back into documents you used recently. "
"It is a faster path when you remember the file, not the folder."
msgstr ""
"Engeza i-applet Yamafayela Akamuva ukuze ugxumele emuva kumadokhumenti "
"osanda kuwasebenzisa. Kuyindlela esheshayo uma ukhumbula ifayela, hhayi "
"ifolda."

#: docking/core/tips.py:266
msgid "Use System Tray when needed"
msgstr "Sebenzisa Ithreyi Yesistimu uma kudingeka"

#: docking/core/tips.py:268
msgid ""
"Add System Tray for tray/status apps and use its menu to manage tray "
"ownership when supported. This helps with legacy apps that still rely on a "
"classic notification area."
msgstr ""
"Engeza Ithreyi Yesistimu yezinhlelo zokusebenza zethreyi/yesimo futhi "
"usebenzise imenyu yayo ukuze ulawule ubunikazi bethreyi lapho kusekelwa. "
"Lokhu kusiza ngezinhlelo zokusebenza zefa ezisathembele endaweni yezaziso "
"yakudala."

#: docking/core/tips.py:275
msgid "Use Diagnostics for support"
msgstr "Sebenzisa i-Diagnostics ukuze uthole ukwesekwa"

#: docking/core/tips.py:277
msgid ""
"Open Diagnostics before filing an issue to copy backend, session, and "
"feature details. Including that report makes it much easier to understand "
"compositor, monitor, and environment-specific problems."
msgstr ""
"Vula i-Diagnostics ngaphambi kokufaka inkinga ukuze ukopishe i-backend, "
"iseshini, nemininingwane yesici. Ukufaka lowo mbiko kwenza kube lula kakhulu "
"ukuqonda umqambi, ukuqapha, kanye nezinkinga eziqondene nendawo ethile."

