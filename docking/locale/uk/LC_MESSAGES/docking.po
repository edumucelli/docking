msgstr "Показувати прогрес завдань, який повідомляють застосунки, на їхніх "
"значках у доці."

#: docking/ui/settings.py:691
msgid "Placement"
msgstr "Розміщення"

#: docking/ui/settings.py:694
msgid "Position"
msgstr "Position"

#: docking/ui/settings.py:696
