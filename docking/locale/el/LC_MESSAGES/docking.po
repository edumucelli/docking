#: docking/ui/settings.py:625
msgid "Look"
msgstr "Εμφάνιση"

#: docking/ui/settings.py:627
msgid "Theme"
msgstr "Θέμα"

#: docking/ui/settings.py:627
msgid "Choose the dock color palette."
msgstr "Επιλέξτε τη χρωματική παλέτα βάσης."

#: docking/ui/settings.py:629
msgid "Icon Size"
msgstr "Icon Size"

#: docking/ui/settings.py:631
msgid "Set the base size of dock icons before zoom is applied."
msgstr ""
"Ορίστε το βασικό μέγεθος των εικονιδίων βάσης προτού εφαρμοστεί το ζουμ."

#: docking/ui/settings.py:634
msgid "Transparency"
msgstr "Transparency"

#: docking/ui/settings.py:636
msgid "Adjust how transparent the dock background is."
msgstr "Προσαρμόστε πόσο διαφανές είναι το φόντο της βάσης."

#: docking/ui/settings.py:639
msgid "Zoom"
msgstr "Zoom"

#: docking/ui/settings.py:641
msgid "Enlarge icons when the pointer hovers over the dock."
msgstr ""
"Μεγεθύνετε τα εικονίδια όταν ο δείκτης αιωρείται πάνω από την αποβάθρα."

#: docking/ui/settings.py:644
msgid "Zoom Percent"
msgstr "Ποσοστό μεγέθυνσης"

#: docking/ui/settings.py:646
msgid "Set how much hovered icons grow when zoom is enabled."
msgstr ""
"Ορίστε πόσα εικονίδια αιωρούνται αυξάνονται όταν είναι ενεργοποιημένο το "
"ζουμ."

#: docking/ui/settings.py:649
msgid "Show Tooltips"
msgstr "Εμφάνιση συμβουλών"

#: docking/ui/settings.py:651
msgid "Show item names and details when hovering over dock items."
msgstr ""
"Εμφάνιση ονομάτων και λεπτομερειών στοιχείων όταν τοποθετείτε το δείκτη του "
"ποντικιού πάνω από τα στοιχεία βάσης."

#: docking/ui/settings.py:654
msgid "Window Previews"
msgstr "Window Previews"

#: docking/ui/settings.py:656
msgid "Show window thumbnails when hovering over running apps."
msgstr ""
"Εμφάνιση μικρογραφιών παραθύρων όταν τοποθετείτε το δείκτη του ποντικιού "
"πάνω από εφαρμογές που εκτελούνται."

#: docking/ui/settings.py:659
msgid "Outline Thumbnail on Hover"
msgstr "Περίγραμμα μικρογραφίας στο πέρασμα του δείκτη"

#: docking/ui/settings.py:661
msgid "Highlight the thumbnail under the pointer in the preview."
msgstr "Επισήμανση της μικρογραφίας κάτω από τον δείκτη στην προεπισκόπηση."

#: docking/ui/settings.py:664
msgid "Show Window Counts"
msgstr "Εμφάνιση μετρήσεων παραθύρων"

#: docking/ui/settings.py:667
msgid "Show a number on running app indicators when multiple windows are open."
msgstr ""
"Εμφάνιση ενός αριθμού στις ενδείξεις εφαρμογών που εκτελούνται όταν είναι "
"ανοιχτά πολλά παράθυρα."

#: docking/ui/settings.py:672
msgid "Application Badges"
msgstr "Σημάνσεις εφαρμογών"

#: docking/ui/settings.py:675
msgid "Show numeric counts reported by applications on their dock icons."
msgstr "Εμφάνιση αριθμητικών μετρητών που αναφέρουν οι εφαρμογές στα "
"εικονίδιά τους στο dock."

#: docking/ui/settings.py:680
msgid "Application Progress"
msgstr "Πρόοδος εφαρμογών"

#: docking/ui/settings.py:683
msgid "Show task progress reported by applications on their dock icons."
msgstr "Εμφάνιση της προόδου εργασιών που αναφέρουν οι εφαρμογές στα "
"εικονίδιά τους στο dock."

#: docking/ui/settings.py:691
msgid "Placement"
msgstr "Τοποθέτηση"

#: docking/ui/settings.py:694
msgid "Position"
msgstr "Position"

#: docking/ui/settings.py:696
msgid "Choose which screen edge the dock uses."
msgstr "Επιλέξτε ποια άκρη οθόνης χρησιμοποιεί η βάση."

#: docking/ui/settings.py:698
msgid "Extra Distance from Edge"
msgstr "Επιπλέον απόσταση από το Edge"

#: docking/ui/settings.py:700
msgid "Current Workspace Only"
msgstr "Current Workspace Only"

#: docking/ui/settings.py:703
msgid "Show running windows only from the active workspace when supported."
msgstr ""
"Εμφάνιση εκτελούμενων παραθύρων μόνο από τον ενεργό χώρο εργασίας όταν "
"υποστηρίζονται."

#: docking/ui/settings.py:711 docking/ui/settings.py:721
msgid "Monitor"
msgstr "Ελεγκτής εκπομπών"

#: docking/ui/settings.py:714
msgid "Follow Cursor"
msgstr "Follow Cursor"

#: docking/ui/settings.py:717
msgid "Move the dock to the monitor where the pointer is currently located."
msgstr ""
"Μετακινήστε τη βάση στην οθόνη όπου βρίσκεται ο δείκτης αυτήν τη στιγμή."

#: docking/ui/settings.py:726
msgid "Layout"
msgstr "Διάταξη"

#: docking/ui/settings.py:729
msgid "Lock Positions"
msgstr "Κλείδωμα θέσεων"

#: docking/ui/settings.py:732
msgid "Prevent dock items from being reordered or removed by drag and drop."
msgstr ""
"Αποτρέψτε την αναδιάταξη ή την αφαίρεση στοιχείων βάσης με μεταφορά και "
"απόθεση."

#: docking/ui/settings.py:737
msgid "Anchor Applets to End"
msgstr "Anchor Applets to End"

#: docking/ui/settings.py:739
msgid "Keep applets grouped at the end of the dock."
msgstr "Διατηρήστε τις μικροεφαρμογές ομαδοποιημένες στο τέλος της αποβάθρας."

#: docking/ui/settings.py:742
msgid "Anchor Files to End"
msgstr "Αγκύρωση αρχείων στο τέλος"

#: docking/ui/settings.py:744
msgid "Keep pinned files and folders grouped at the end of the dock."
msgstr ""
"Διατηρήστε τα καρφιτσωμένα αρχεία και φακέλους ομαδοποιημένα στο τέλος της "
"βάσης."

#: docking/ui/settings.py:783
msgid "Left Click"
msgstr "Left Click"

#: docking/ui/settings.py:786
msgid ""
"Choose what happens when clicking a running app with the left mouse button."
msgstr ""
"Επιλέξτε τι θα συμβεί όταν κάνετε κλικ σε μια εφαρμογή που εκτελείται με το "
"αριστερό κουμπί του ποντικιού."

#: docking/ui/settings.py:791
msgid "Middle Click"
msgstr "Middle Click"

#: docking/ui/settings.py:794
msgid "Choose what happens when clicking an app with the middle mouse button."
msgstr ""
"Επιλέξτε τι συμβαίνει όταν κάνετε κλικ σε μια εφαρμογή με το μεσαίο κουμπί "
"του ποντικιού."

#: docking/ui/settings.py:799
msgid "Window List Sort"
msgstr "Ταξινόμηση λίστας παραθύρων"

#: docking/ui/settings.py:801
msgid "Choose how open windows are ordered in app context menus."
msgstr ""
"Επιλέξτε τον τρόπο σειράς των ανοιχτών παραθύρων στα μενού περιβάλλοντος "
"εφαρμογών."

#: docking/ui/settings.py:809
msgid "Hide Mode"
msgstr "Λειτουργία απόκρυψης"

#: docking/ui/settings.py:811
msgid "Hide Delay"
msgstr "Καθυστέρηση απόκρυψης"

#: docking/ui/settings.py:814
msgid "Set how long the dock waits before hiding after the pointer leaves."
msgstr ""
"Ορίστε πόσο καιρό θα περιμένει η βάση προτού κρυφτεί μετά την αποχώρηση του "
"δείκτη."

#: docking/ui/settings.py:819
msgid "Unhide Delay"
msgstr "Καθυστέρηση εμφάνισης"

#: docking/ui/settings.py:822
msgid "Set how long the dock waits before showing after the pointer returns."
msgstr ""
"Ρυθμίστε πόσο καιρό θα περιμένει το dock πριν εμφανιστεί μετά την επιστροφή "
"του δείκτη."

#: docking/ui/settings.py:827
msgid "Pressure Reveal"
msgstr "Αποκάλυψη πίεσης"

#: docking/ui/settings.py:830
msgid ""
"Require the pointer to push against the screen edge before revealing a "
"hidden dock."
msgstr ""
"Απαιτήστε από τον δείκτη να πιέζει την άκρη της οθόνης πριν αποκαλύψει μια "
"κρυφή βάση."

#: docking/ui/settings.py:834
msgid "Pressure Threshold"
msgstr "Κατώφλι Πίεσης"

#: docking/ui/settings.py:836
msgid "Show Startup Tips"
msgstr "Εμφάνιση Συμβουλών εκκίνησης"

#: docking/ui/settings.py:839
msgid ""
"Show one Docking usage tip after startup, unless a higher-priority startup "
"notification is visible."
msgstr ""
"Εμφάνιση μιας συμβουλής χρήσης σύνδεσης μετά την εκκίνηση, εκτός εάν είναι "
"ορατή μια ειδοποίηση εκκίνησης υψηλότερης προτεραιότητας."

#: docking/ui/settings.py:847
msgid "Stacks"
msgstr "Στοίβες"

#: docking/ui/settings.py:850
msgid "Open On"
msgstr "Open On"

#: docking/ui/settings.py:852
msgid "Choose whether stacks open on click or while hovering."
msgstr "Επιλέξτε αν οι στοίβες ανοίγουν με κλικ ή με το πέρασμα του δείκτη."

#: docking/ui/settings.py:858
msgid "Recent Apps"
msgstr "Πρόσφατες εφαρμογές"

#: docking/ui/settings.py:861
msgid "Show Recently Used Apps"
msgstr "Εμφάνιση εφαρμογών που χρησιμοποιήθηκαν πρόσφατα"

#: docking/ui/settings.py:864
msgid "Show recently closed apps between pinned launchers and running apps."
msgstr ""
"Εμφάνιση εφαρμογών που έκλεισαν πρόσφατα μεταξύ καρφιτσωμένων εκκινητήρων "
"και εφαρμογών που εκτελούνται."

#: docking/ui/settings.py:869
msgid "Number of Recent Apps"
msgstr "Αριθμός πρόσφατων εφαρμογών"

#: docking/ui/settings.py:871
msgid "Maximum recently used app icons to display."
msgstr ""
"Μέγιστα εικονίδια εφαρμογών που χρησιμοποιήθηκαν πρόσφατα για εμφάνιση."

#: docking/ui/settings.py:874
msgid "Keep Recent Apps For"
msgstr "Διατήρηση πρόσφατων εφαρμογών για"

#: docking/ui/settings.py:876
msgid "Remove recent apps after this many days of inactivity."
msgstr "Καταργήστε τις πρόσφατες εφαρμογές μετά από τόσες μέρες αδράνειας."

#: docking/ui/settings.py:885
msgid "Show Recent Documents"
msgstr "Εμφάνιση πρόσφατων εγγράφων"

#: docking/ui/settings.py:888
msgid "Show a \"Recent Documents\" submenu when right-clicking an app icon."
msgstr ""
"Εμφάνιση ενός υπομενού \\\"Πρόσφατα έγγραφα\\\" όταν κάνετε δεξί κλικ σε ένα "
"εικονίδιο εφαρμογής."

#: docking/ui/settings.py:893
msgid "Max Documents Per App"
msgstr "Μέγιστος αριθμός εγγράφων ανά εφαρμογή"

#: docking/ui/settings.py:895
msgid "Maximum recent document entries shown per app."
msgstr "Εμφανίζονται μέγιστες πρόσφατες καταχωρίσεις εγγράφων ανά εφαρμογή."

#: docking/ui/settings.py:901
msgid "Global Search"
msgstr "Καθολική αναζήτηση"

#: docking/ui/settings.py:906
msgid "Enable Docking's process-wide search palette."
msgstr "Ενεργοποίηση της παλέτας αναζήτησης του Docking για όλες τις "
"διεργασίες."

#: docking/ui/settings.py:909
msgid "Preferred Shortcut"
msgstr "Προτιμώμενη συντόμευση"

#: docking/ui/settings.py:912
msgid ""
"Click the button, then press the desired key sequence. The desktop may "
"reserve some shortcuts."
msgstr "Κάντε κλικ στο κουμπί και μετά πατήστε τον επιθυμητό συνδυασμό "
"πλήκτρων. Η επιφάνεια εργασίας ενδέχεται να δεσμεύει ορισμένες συντομεύσεις."

#: docking/ui/settings.py:917
msgid "Search Engine"
msgstr "Μηχανή αναζήτησης"

#: docking/ui/settings.py:919
msgid "Choose the engine used by web fallback."
msgstr "Επιλέξτε τη μηχανή που χρησιμοποιείται για την εναλλακτική αναζήτηση "
"στον ιστό."

#: docking/ui/settings.py:991
msgid "Check Now"
msgstr "Έλεγχος τώρα"

#: docking/ui/settings.py:993
msgid "View Releases"
msgstr "Προβολή εκδόσεων"

#: docking/ui/settings.py:1005
msgid "Update Checks"
msgstr "Έλεγχοι ενημερώσεων"

#: docking/ui/settings.py:1007
msgid "Check Automatically"
msgstr "Αυτόματος έλεγχος"

#: docking/ui/settings.py:1008
msgid "Frequency"
msgstr "Συχνότητα"

#: docking/ui/settings.py:1009
msgid "Status"
msgstr "Κατάσταση"

#: docking/ui/settings.py:1489
msgid "Primary Display"
msgstr "Κύρια οθόνη"

#: docking/ui/settings.py:1500
#, python-brace-format
msgid "Shortcut Status: {status}"
msgstr "Κατάσταση συντόμευσης: {status}"

#: docking/ui/settings.py:1639
#, python-brace-format
msgid "Last seen version: {version}"
msgstr "Τελευταία γνωστή έκδοση: {version}"

#: docking/ui/settings.py:1643
msgid "No update found yet"
msgstr "Δεν βρέθηκε ακόμη ενημέρωση"

#: docking/ui/settings.py:1645
msgid "Not checked yet"
msgstr "Δεν έχει ελεγχθεί ακόμη"

#: docking/ui/settings.py:1728
msgid "The dock is always visible and reserves screen space."
msgstr "Το dock είναι πάντα ορατό και δεσμεύει χώρο στην οθόνη."

#: docking/ui/settings.py:1730
msgid ""
"Always visible and floats above all windows without reserving screen space."
msgstr ""
"Πάντα ορατό και επιπλέει πάνω από όλα τα παράθυρα χωρίς να δεσμεύει χώρο."

#: docking/ui/settings.py:1733
msgid "Hides when the mouse cursor leaves the dock."
msgstr "Hides when the mouse cursor leaves the dock."

#: docking/ui/settings.py:1735
msgid ""
"Hides when a window from the focused application overlaps the dock area."
msgstr ""
"Hides when a window from the focused application overlaps the dock area."

#: docking/ui/settings.py:1737
msgid "Hides when the focused window overlaps the dock area."
msgstr "Hides when the focused window overlaps the dock area."

#: docking/ui/settings.py:1739
msgid "Hides when any window on the current workspace overlaps the dock area."
msgstr "Hides when any window on the current workspace overlaps the dock area."

#: docking/ui/settings.py:1742
msgid ""
"Hides when the focused window is maximized or a dialog overlaps the dock."
msgstr ""
"Hides when the focused window is maximized or a dialog overlaps the dock."

#: docking/ui/stack.py:125
msgid "No items"
msgstr "Δεν υπάρχουν στοιχεία"

#: docking/ui/startup_tips.py:187
msgid "Tip of the day"
msgstr "Συμβουλή της ημέρας"

#: docking/ui/startup_tips.py:212
msgid "Show tips on startup"
msgstr "Εμφάνιση συμβουλών για την εκκίνηση"

#: docking/ui/startup_tips.py:215
msgid "Next Tip"
msgstr "Επόμενη Συμβουλή"

#: docking/ui/tooltip.py:222
msgid "1 day"
msgstr "1 ημέρα"

#: docking/ui/tooltip.py:222
#, python-brace-format
msgid "{count} days"
msgstr "{count} ημέρες"

#: docking/ui/tooltip.py:240
msgid "just now"
msgstr "μόλις τώρα"

#: docking/ui/tooltip.py:241
#, python-brace-format
msgid "{age} ago"
msgstr "{age} πριν"

#: docking/ui/update_popup.py:231
#, python-brace-format
msgid "Docking {version} is available"
msgstr "Διαθέσιμη η Docking {version}"

#: docking/ui/update_popup.py:237
#, python-brace-format
msgid "You are using {version}."
msgstr "Χρησιμοποιείτε {version}."

#: docking/ui/update_popup.py:246
msgid "View Release"
msgstr "Προβολή έκδοσης"

#: docking/ui/update_popup.py:247
