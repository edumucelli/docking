#: docking/core/tips.py:57
msgid "Open the dock menu from anywhere"
msgstr "Ireki dock menua edonondik"

#: docking/core/tips.py:59
msgid ""
"Hold Ctrl and right-click anywhere on the shelf to open the dock menu. This "
"is the quickest path to Preferences, Applets, Diagnostics, and Quit when "
"there is no empty space near the icons."
msgstr ""
"Eduki sakatuta Ctrl eta egin klik eskuineko botoiarekin apaleko edozein "
"lekutan dock menua irekitzeko. Hau da Hobespenak, Applet-ak, Diagnostikoak "
"eta Irtenerako biderik azkarrena ikonoen ondoan hutsunerik ez dagoenean."

#: docking/core/tips.py:67
msgid "Start with Preferences"
msgstr "Hasi Hobespenekin"

#: docking/core/tips.py:69
msgid ""
"Use Preferences to adjust position, monitor behavior, icon size, zoom, "
"hiding, themes, previews, tooltips, and click actions. It is the best first "
"stop when the dock does not feel quite right."
msgstr ""
"Erabili Hobespenak posizioa, portaera monitorizatzeko, ikonoaren tamaina, "
"zooma, ezkutatzea, gaiak, aurrebistak, tresna-aholkuak eta klik-ekintzak "
"doitzeko. Kaia ondo sentitzen ez denean lehen geldialdirik onena da."

#: docking/core/tips.py:76
msgid "Add applets from the dock menu"
msgstr "Gehitu miniaplikazioak dock menutik"

#: docking/core/tips.py:78
msgid ""
"Right-click the shelf background and choose Add Applet to add launchers, "
"system status, media controls, productivity helpers, and small utility tools "
"directly to the dock."
msgstr ""
"Egin klik eskuineko botoiarekin apaleko atzeko planoan eta aukeratu Gehitu "
"Applet abiarazleak, sistemaren egoera, multimedia kontrolak, "
"produktibitatearen laguntzaileak eta erabilgarritasun-tresna txikiak "
"zuzenean kaian gehitzeko."

#: docking/core/tips.py:85
msgid "Use separators for organization"
msgstr "Erabili bereizleak antolatzeko"

#: docking/core/tips.py:87
msgid ""
"Right-click where a divider should go and choose Add Separator. Separators "
"make it easier to keep pinned apps, folders, and applets in clear groups."
msgstr ""
"Egin klik eskuineko botoiarekin zatitzailea joan behar den tokira eta "
"aukeratu Gehitu bereizlea. Banatzaileek ainguratutako aplikazioak, karpetak "
"eta miniaplikazioak talde argietan gordetzea errazten dute."

#: docking/core/tips.py:94
msgid "Pin running apps"
msgstr "Ainguratu exekutatzen ari diren aplikazioak"

#: docking/core/tips.py:96
msgid ""
"Right-click a running app and choose Keep in Dock. The launcher will stay "
"available after the app closes, so you can start it again with one click."
msgstr ""
"Egin klik eskuineko botoiarekin martxan dagoen aplikazio batean eta aukeratu "
"Keep in Dock. Aplikazioa itxi ondoren erabilgarri egongo da abiarazlea, eta, "
"beraz, klik batekin berriro abi dezakezu."

#: docking/core/tips.py:103
msgid "Remove pinned items quickly"
msgstr "Kendu ainguratutako elementuak azkar"

#: docking/core/tips.py:105
msgid ""
"Right-click a pinned item and choose Remove from Dock, or drag unlocked "
"items off the dock. Removing a launcher does not uninstall the application "
"or delete your files."
msgstr ""
"Egin klik eskuineko botoiarekin ainguratutako elementu batean eta aukeratu "
"Kendu kaitik, edo arrastatu desblokeatutako elementuak kaitik kanpo. "
"Abiarazle bat kentzeak ez du aplikazioa desinstalatzen edo zure fitxategiak "
"ezabatzen."

#: docking/core/tips.py:112
msgid "Drop items onto the dock"
msgstr "Jaregin elementuak kaira"

#: docking/core/tips.py:114
msgid ""
"Drag applications, .desktop files, files, folders, and AppImages onto "
"Docking to pin them. Dropped folders become folder stacks, and dropped "
"AppImages can get their own launcher."
msgstr ""
"Arrastatu aplikazioak, .desktop fitxategiak, fitxategiak, karpetak eta "
"AppImages Docking-era haiek ainguratzeko. Jaregindako karpetak karpeta-pila "
"bihurtzen dira, eta erortutako AppImagesek beren abiarazlea lor dezakete."

#: docking/core/tips.py:121
msgid "Open files with dock apps"
msgstr "Ireki fitxategiak dock aplikazioekin"

#: docking/core/tips.py:123
msgid ""
"Drag a file onto an application icon to open it with that app. This is "
"useful when the file manager would otherwise choose the wrong default "
"application."
msgstr ""
"Arrastatu fitxategi bat aplikazioaren ikono batera aplikazio horrekin "
"irekitzeko. Baliagarria da fitxategi-kudeatzaileak bestela aplikazio "
"lehenetsi okerra aukeratuko balu."

#: docking/core/tips.py:130
msgid "Use folder stacks"
msgstr "Erabili karpeta-pilak"

#: docking/core/tips.py:132
msgid ""
"Pin a folder and click it from the dock to browse its contents without "
"opening a file manager first. It works well for common places like "
"Downloads, Projects, and screenshots."
msgstr ""
"Ainguratu karpeta bat eta egin klik kaitik bere edukia arakatzeko fitxategi-"
"kudeatzailerik ireki gabe. Ondo funtzionatzen du Deskargak, Proiektuak eta "
"pantaila-argazkiak bezalako toki arruntetarako."

#: docking/core/tips.py:139
msgid "Tune folder stack behavior"
msgstr "Sintonizatu karpeta pilaren portaera"

#: docking/core/tips.py:141
msgid ""
"Right-click a pinned folder to sort contents, show hidden files, or "
"customize its icon. These options let each stack behave like the folder it "
"represents."
msgstr ""
"Egin klik eskuineko botoiarekin ainguratutako karpeta batean edukiak "
"ordenatzeko, ezkutuko fitxategiak erakusteko edo haren ikonoa "
"pertsonalizatzeko. Aukera hauei esker pila bakoitza ordezkatzen duen "
"karpetaren antzera jokatzen da."

#: docking/core/tips.py:148
msgid "Customize pinned icons"
msgstr "Pertsonalizatu ainguratutako ikonoak"

#: docking/core/tips.py:150
msgid ""
"Right-click a pinned app, file, or folder and use Icon -> Choose From File. "
"Custom icons are stored in Docking's config, so the original desktop file or "
"file on disk is left untouched."
msgstr ""
"Egin klik eskuineko botoiarekin ainguratutako aplikazio, fitxategi edo "
"karpeta batean eta erabili Ikonoa -> Aukeratu fitxategitik. Ikono "
"pertsonalizatuak Docking-en konfigurazioan gordetzen dira, beraz, jatorrizko "
"mahaigaineko fitxategia edo diskoko fitxategia ukitu gabe geratzen da."

#: docking/core/tips.py:157
msgid "Use the Applications applet search"
msgstr "Erabili Aplikazioak applet bilaketa"

#: docking/core/tips.py:159
msgid ""
"Add the Applications applet, open it, and type to filter installed apps. It "
"gives you a compact launcher menu without leaving the dock."
msgstr ""
"Gehitu Aplikazioen miniaplikazioa, ireki eta idatzi instalatutako "
"aplikazioak iragazteko. Abiarazlearen menu trinkoa eskaintzen dizu kaitik "
"irten gabe."

#: docking/core/tips.py:166
msgid "Use Run Application like Alt+F2"
msgstr "Erabili Exekutatu aplikazioa Alt+F2 bezala"

#: docking/core/tips.py:168
msgid ""
"Add Run Application to launch commands, apps, and terminal commands from the "
"dock. As you type, matching applications are shown so you can launch by name "
"or run a standalone command."
msgstr ""
"Gehitu Exekutatu aplikazioa kaitik komandoak, aplikazioak eta terminaleko "
"komandoak abiarazteko. Idazten duzun heinean, bat datozen aplikazioak "
"erakusten dira, izenaren arabera abiarazteko edo komando autonomo bat "
"abiarazteko."

#: docking/core/tips.py:175
msgid "Use window previews"
msgstr "Erabili leihoen aurrebistak"

#: docking/core/tips.py:177
msgid ""
"Hover running apps to inspect open windows before switching. Previews help "
"when one application has several windows open."
msgstr ""
"Pasatu gainean exekutatzen ari diren aplikazioak irekitako leihoak "
"ikuskatzeko aldatu aurretik. Aurrebistek laguntzen dute aplikazio batek "
"hainbat leiho irekita dituenean."

#: docking/core/tips.py:183
msgid "Choose your click behavior"
msgstr "Aukeratu klikaren portaera"

#: docking/core/tips.py:185
msgid ""
"Preferences -> Behavior lets left click toggle, cycle, or focus the most "
"recent window. Pick the behavior that matches how you switch between running "
"applications."
msgstr ""
"Hobespenak -> Jokabidea aukera ematen du ezkerreko klika aldatzeko, zikloka "
"edo bideratzeko azken leihoa. Aukeratu exekutatzen ari zaren aplikazioen "
"artean aldatzeko moduarekin bat datorren portaera."

#: docking/core/tips.py:192
msgid "Ctrl-click opens a new window"
msgstr "Ktrl-klik sakatuta leiho berri bat irekiko da"

#: docking/core/tips.py:194
msgid ""
"Hold Ctrl while clicking an app icon to launch another window. This works "
"even when the app is already running and a normal click would focus it."
msgstr ""
"Eduki sakatuta Ctrl aplikazioaren ikono batean klik egiten duzun bitartean "
"beste leiho bat abiarazteko. Honek funtzionatzen du aplikazioa dagoeneko "
"martxan dagoenean eta klik arrunt batek bideratuko luke."

#: docking/core/tips.py:201
msgid "Use app right-click menus"
msgstr "Erabili aplikazioaren eskuineko botoiarekin klik egiteko menuak"

#: docking/core/tips.py:203
msgid ""
"Right-click apps for desktop actions, open windows, recent documents, "
"pinning, and close actions. Many apps expose useful shortcuts there, such as "
"opening a private window or composing a new message."
msgstr ""
"Egin klik eskuineko botoiarekin mahaigaineko ekintzetarako, leihoak "
"irekitzeko, azken dokumentuak, ainguratzeko eta ixteko ekintzetarako. "
"Aplikazio askok lasterbide erabilgarriak erakusten dituzte bertan, hala nola "
"leiho pribatu bat irekitzea edo mezu berri bat idaztea."

#: docking/core/tips.py:211
msgid "Use Recent Files"
msgstr "Erabili azken fitxategiak"

#: docking/core/tips.py:213
msgid ""
"Add the Recent Files applet to jump back into documents you used recently. "
"It is a faster path when you remember the file, not the folder."
msgstr ""
"Gehitu Azken fitxategiak aplikazioa duela gutxi erabili dituzun "
"dokumentuetara itzultzeko. Fitxategia gogoratzen duzunean bide azkarragoa "
"da, ez karpeta."

#: docking/core/tips.py:220
msgid "Use System Tray when needed"
msgstr "Erabili sistemaren erretilua behar denean"

#: docking/core/tips.py:222
msgid ""
"Add System Tray for tray/status apps and use its menu to manage tray "
"ownership when supported. This helps with legacy apps that still rely on a "
"classic notification area."
msgstr ""
"Gehitu sistema erretilua erretilu/egoera aplikazioetarako eta erabili bere "
"menua erretiluaren jabetza kudeatzeko, onartzen denean. Honek oraindik "
"jakinarazpen-eremu klasiko batean oinarritzen diren lehengo aplikazioekin "
"laguntzen du."

#: docking/core/tips.py:229
msgid "Use Diagnostics for support"
msgstr "Erabili Diagnostikoak laguntzarako"

#: docking/core/tips.py:231
msgid ""
"Open Diagnostics before filing an issue to copy backend, session, and "
"feature details. Including that report makes it much easier to understand "
"compositor, monitor, and environment-specific problems."
msgstr ""
"Ireki Diagnostikoak arazo bat aurkeztu aurretik backend-a, saioaren eta "
"funtzioen xehetasunak kopiatzeko. Txosten hori sartzeak asko errazten du "
"konposaketa, monitorea eta inguruneko berariazko arazoak ulertzea."

