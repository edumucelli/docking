msgstr "إظهار النوافذ قيد التشغيل فقط من مساحة العمل النشطة عندما تكون مدعومة."

#: docking/ui/settings.py:711 docking/ui/settings.py:721
msgid "Monitor"
msgstr "شاشة"

#: docking/ui/settings.py:714
msgid "Follow Cursor"
msgstr "تتبع المؤشر"

#: docking/ui/settings.py:717
msgid "Move the dock to the monitor where the pointer is currently located."
msgstr "انقل المرسى إلى الشاشة حيث يوجد المؤشر حاليًا."

#: docking/ui/settings.py:726
msgid "Layout"
msgstr "التخطيط"

#: docking/ui/settings.py:729
msgid "Lock Positions"
msgstr "قفل المواضع"

#: docking/ui/settings.py:732
msgid "Prevent dock items from being reordered or removed by drag and drop."
msgstr "منع إعادة ترتيب عناصر الإرساء أو إزالتها عن طريق السحب والإفلات."

#: docking/ui/settings.py:737
msgid "Anchor Applets to End"
msgstr "تثبيت التطبيقات المصغرة في النهاية"

#: docking/ui/settings.py:739
msgid "Keep applets grouped at the end of the dock."
msgstr "احتفظ بالتطبيقات الصغيرة مجمعة في نهاية الرصيف."

#: docking/ui/settings.py:742
msgid "Anchor Files to End"
msgstr "تثبيت الملفات في النهاية"

#: docking/ui/settings.py:744
msgid "Keep pinned files and folders grouped at the end of the dock."
msgstr "احتفظ بالملفات والمجلدات المثبتة مجمعة في نهاية الإرساء."

#: docking/ui/settings.py:783
msgid "Left Click"
msgstr "Left Click"

#: docking/ui/settings.py:786
msgid ""
"Choose what happens when clicking a running app with the left mouse button."
msgstr ""
"اختر ما يحدث عند النقر فوق تطبيق قيد التشغيل باستخدام زر الماوس الأيسر."

#: docking/ui/settings.py:791
msgid "Middle Click"
msgstr "Middle Click"

#: docking/ui/settings.py:794
msgid "Choose what happens when clicking an app with the middle mouse button."
msgstr "اختر ما يحدث عند النقر فوق أحد التطبيقات باستخدام زر الماوس الأوسط."

#: docking/ui/settings.py:799
msgid "Window List Sort"
msgstr "فرز قائمة النوافذ"

#: docking/ui/settings.py:801
msgid "Choose how open windows are ordered in app context menus."
msgstr "اختر كيفية ترتيب النوافذ المفتوحة في قوائم سياق التطبيق."

#: docking/ui/settings.py:809
msgid "Hide Mode"
msgstr "وضع الإخفاء"

#: docking/ui/settings.py:811
msgid "Hide Delay"
msgstr "تأخير الإخفاء"

#: docking/ui/settings.py:814
msgid "Set how long the dock waits before hiding after the pointer leaves."
msgstr "قم بتعيين المدة التي ينتظرها المرسى قبل الاختباء بعد مغادرة المؤشر."

#: docking/ui/settings.py:819
msgid "Unhide Delay"
msgstr "تأخير الظهور"

#: docking/ui/settings.py:822
msgid "Set how long the dock waits before showing after the pointer returns."
msgstr "قم بتعيين المدة التي ينتظرها الإرساء قبل أن يظهر بعد عودة المؤشر."

#: docking/ui/settings.py:827
msgid "Pressure Reveal"
msgstr "كشف الضغط"

#: docking/ui/settings.py:830
msgid ""
"Require the pointer to push against the screen edge before revealing a "
"hidden dock."
msgstr "اطلب من المؤشر الضغط على حافة الشاشة قبل الكشف عن رصيف مخفي."

#: docking/ui/settings.py:834
msgid "Pressure Threshold"
msgstr "عتبة الضغط"

#: docking/ui/settings.py:836
msgid "Show Startup Tips"
msgstr "عرض نصائح بدء التشغيل"

#: docking/ui/settings.py:839
msgid ""
"Show one Docking usage tip after startup, unless a higher-priority startup "
"notification is visible."
msgstr ""
"اعرض تلميحًا واحدًا لاستخدام الإرساء بعد بدء التشغيل، ما لم يكن إشعار بدء "
"التشغيل ذو الأولوية الأعلى مرئيًا."

#: docking/ui/settings.py:847
msgid "Stacks"
msgstr "المكدّسات"

#: docking/ui/settings.py:850
msgid "Open On"
msgstr "Open On"

#: docking/ui/settings.py:852
msgid "Choose whether stacks open on click or while hovering."
msgstr "اختر ما إذا كانت المكدّسات تُفتح بالنقر أم عند التمرير."

#: docking/ui/settings.py:858
msgid "Recent Apps"
msgstr "التطبيقات الحديثة"

#: docking/ui/settings.py:861
msgid "Show Recently Used Apps"
msgstr "عرض التطبيقات المستخدمة مؤخرًا"

#: docking/ui/settings.py:864
msgid "Show recently closed apps between pinned launchers and running apps."
msgstr ""
"إظهار التطبيقات المغلقة مؤخرًا بين المشغلات المثبتة والتطبيقات قيد التشغيل."

#: docking/ui/settings.py:869
msgid "Number of Recent Apps"
msgstr "عدد التطبيقات الحديثة"

#: docking/ui/settings.py:871
msgid "Maximum recently used app icons to display."
msgstr "الحد الأقصى لأيقونات التطبيقات المستخدمة مؤخرًا للعرض."

#: docking/ui/settings.py:874
msgid "Keep Recent Apps For"
msgstr "احتفظ بالتطبيقات الحديثة لـ"

#: docking/ui/settings.py:876
msgid "Remove recent apps after this many days of inactivity."
msgstr "قم بإزالة التطبيقات الحديثة بعد هذه الأيام العديدة من عدم النشاط."

#: docking/ui/settings.py:885
msgid "Show Recent Documents"
msgstr "إظهار المستندات الحديثة"

#: docking/ui/settings.py:888
msgid "Show a \"Recent Documents\" submenu when right-clicking an app icon."
msgstr ""
"إظهار القائمة الفرعية \\\"المستندات الحديثة\\\" عند النقر بزر الماوس الأيمن "
"على أيقونة التطبيق."

#: docking/ui/settings.py:893
msgid "Max Documents Per App"
msgstr "الحد الأقصى للمستندات لكل تطبيق"

#: docking/ui/settings.py:895
msgid "Maximum recent document entries shown per app."
msgstr "الحد الأقصى لإدخالات المستندات الحديثة المعروضة لكل تطبيق."

#: docking/ui/settings.py:901
msgid "Global Search"
msgstr "البحث العام"

#: docking/ui/settings.py:906
msgid "Enable Docking's process-wide search palette."
msgstr "تمكين لوحة البحث على مستوى العملية في Docking."

#: docking/ui/settings.py:909
msgid "Preferred Shortcut"
msgstr "الاختصار المفضّل"

#: docking/ui/settings.py:912
msgid ""
"Click the button, then press the desired key sequence. The desktop may "
"reserve some shortcuts."
msgstr "انقر على الزر، ثم اضغط تسلسل المفاتيح المطلوب. قد يحتفظ سطح المكتب "
"ببعض الاختصارات."

#: docking/ui/settings.py:917
msgid "Search Engine"
msgstr "محرك البحث"

#: docking/ui/settings.py:919
msgid "Choose the engine used by web fallback."
msgstr "اختر المحرك المستخدم في البحث على الويب كخيار احتياطي."

#: docking/ui/settings.py:991
msgid "Check Now"
msgstr "تحقق الآن"

#: docking/ui/settings.py:993
msgid "View Releases"
msgstr "عرض الإصدارات"

#: docking/ui/settings.py:1005
msgid "Update Checks"
msgstr "فحوصات التحديث"

#: docking/ui/settings.py:1007
msgid "Check Automatically"
msgstr "تحقق تلقائيًا"

#: docking/ui/settings.py:1008
msgid "Frequency"
msgstr "التردد"

#: docking/ui/settings.py:1009
msgid "Status"
msgstr "الحالة"

#: docking/ui/settings.py:1489
msgid "Primary Display"
msgstr "العرض الأساسي"

