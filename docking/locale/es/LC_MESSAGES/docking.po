#: docking/ui/settings.py:917
msgid "Search Engine"
msgstr "Motor de búsqueda"

#: docking/ui/settings.py:919
msgid "Choose the engine used by web fallback."
msgstr "Elige el motor que se usa cuando la búsqueda recurre a la web."

