#: docking/ui/settings.py:469
msgid ""
"When Follow Cursor is enabled, the dock follows the pointer across monitors. "
"The selected monitor is kept as the fallback."
msgstr ""
"Cuando Seguir el cursor está habilitado, la base sigue el puntero a través "
"de los monitores. El monitor seleccionado se mantiene como respaldo."

#: docking/ui/settings.py:515
msgid "Added on top of the theme's own distance from the edge."
msgstr "Agregado encima de la propia distancia del tema desde el borde."

#: docking/ui/settings.py:555
msgid ""
"Pixels of cursor pressure against the edge required to reveal a hidden dock. "
"Higher values mean the dock will not reveal as easily."
msgstr ""
"Se requieren píxeles de presión del cursor contra el borde para revelar un "
"muelle oculto. Los valores más altos significan que el muelle no se revelará "
"tan fácilmente."

#: docking/ui/settings.py:625
msgid "Look"
msgstr "Aspecto"

#: docking/ui/settings.py:627
msgid "Theme"
msgstr "Tema"

#: docking/ui/settings.py:627
msgid "Choose the dock color palette."
msgstr "Elija la paleta de colores del muelle."

#: docking/ui/settings.py:629
msgid "Icon Size"
msgstr "Tamaño del Ícono"

#: docking/ui/settings.py:631
msgid "Set the base size of dock icons before zoom is applied."
msgstr ""
"Establezca el tamaño base de los iconos del acoplamiento antes de aplicar el "
"zoom."

#: docking/ui/settings.py:634
msgid "Transparency"
msgstr "Transparency"

#: docking/ui/settings.py:636
msgid "Adjust how transparent the dock background is."
msgstr "Ajuste qué tan transparente es el fondo del muelle."

#: docking/ui/settings.py:639
msgid "Zoom"
msgstr "Zoom"

#: docking/ui/settings.py:641
msgid "Enlarge icons when the pointer hovers over the dock."
msgstr "Amplíe los iconos cuando el puntero pase sobre el muelle."

#: docking/ui/settings.py:644
msgid "Zoom Percent"
msgstr "Porcentaje de Zoom"

#: docking/ui/settings.py:646
msgid "Set how much hovered icons grow when zoom is enabled."
msgstr ""
"Establezca cuánto crecen los íconos suspendidos cuando el zoom está "
"habilitado."

#: docking/ui/settings.py:649
msgid "Show Tooltips"
msgstr "Mostrar Sugerencias"

#: docking/ui/settings.py:651
msgid "Show item names and details when hovering over dock items."
msgstr ""
"Muestra los nombres y detalles de los elementos al pasar el cursor sobre los "
"elementos del muelle."

#: docking/ui/settings.py:654
msgid "Window Previews"
msgstr "Vista Previa de Ventanas"

#: docking/ui/settings.py:656
msgid "Show window thumbnails when hovering over running apps."
msgstr ""
"Muestra miniaturas de ventanas al pasar el cursor sobre aplicaciones en "
"ejecución."

#: docking/ui/settings.py:659
msgid "Outline Thumbnail on Hover"
msgstr "Contorno de la miniatura al pasar el cursor"

#: docking/ui/settings.py:661
msgid "Highlight the thumbnail under the pointer in the preview."
msgstr "Resalta la miniatura bajo el puntero en la vista previa."

#: docking/ui/settings.py:664
msgid "Show Window Counts"
msgstr "Mostrar recuentos de ventanas"

#: docking/ui/settings.py:667
msgid "Show a number on running app indicators when multiple windows are open."
msgstr ""
"Muestra un número en los indicadores de la aplicación en ejecución cuando "
"hay varias ventanas abiertas."

#: docking/ui/settings.py:672
msgid "Application Badges"
msgstr "Distintivos de aplicaciones"

#: docking/ui/settings.py:675
msgid "Show numeric counts reported by applications on their dock icons."
msgstr "Muestra los recuentos numéricos notificados por las aplicaciones en "
"sus iconos del dock."

#: docking/ui/settings.py:680
msgid "Application Progress"
msgstr "Progreso de aplicaciones"

#: docking/ui/settings.py:683
msgid "Show task progress reported by applications on their dock icons."
msgstr "Muestra el progreso de tareas notificado por las aplicaciones en sus "
"iconos del dock."

#: docking/ui/settings.py:691
msgid "Placement"
msgstr "Ubicacion"

#: docking/ui/settings.py:694
msgid "Position"
msgstr "Posición"

#: docking/ui/settings.py:696
msgid "Choose which screen edge the dock uses."
msgstr "Elija qué borde de pantalla utiliza la base."

#: docking/ui/settings.py:698
msgid "Extra Distance from Edge"
msgstr "Distancia adicional desde el borde"

#: docking/ui/settings.py:700
msgid "Current Workspace Only"
msgstr "Solo espacio de trabajo actual"

#: docking/ui/settings.py:703
msgid "Show running windows only from the active workspace when supported."
msgstr ""
"Mostrar ventanas en ejecución solo desde el espacio de trabajo activo cuando "
"sea compatible."

#: docking/ui/settings.py:711 docking/ui/settings.py:721
msgid "Monitor"
msgstr "Monitor"

#: docking/ui/settings.py:714
msgid "Follow Cursor"
msgstr "Seguir cursor"

#: docking/ui/settings.py:717
msgid "Move the dock to the monitor where the pointer is currently located."
msgstr "Mueva la base al monitor donde se encuentra actualmente el puntero."

#: docking/ui/settings.py:726
msgid "Layout"
msgstr "Disposicion"

#: docking/ui/settings.py:729
msgid "Lock Positions"
msgstr "Bloquear Posiciones"

#: docking/ui/settings.py:732
msgid "Prevent dock items from being reordered or removed by drag and drop."
msgstr ""
"Evite que los elementos del muelle se reordenen o eliminen arrastrando y "
"soltando."

#: docking/ui/settings.py:737
msgid "Anchor Applets to End"
msgstr "Anclar applets al final"

#: docking/ui/settings.py:739
msgid "Keep applets grouped at the end of the dock."
msgstr "Mantenga los subprogramas agrupados al final del muelle."

#: docking/ui/settings.py:742
msgid "Anchor Files to End"
msgstr "Fijar Archivos al Final"

#: docking/ui/settings.py:744
msgid "Keep pinned files and folders grouped at the end of the dock."
msgstr "Mantenga los archivos y carpetas anclados agrupados al final del Dock."

#: docking/ui/settings.py:783
msgid "Left Click"
msgstr "Left Click"

#: docking/ui/settings.py:786
msgid ""
"Choose what happens when clicking a running app with the left mouse button."
msgstr ""
"Elija qué sucede al hacer clic en una aplicación en ejecución con el botón "
"izquierdo del mouse."

#: docking/ui/settings.py:791
msgid "Middle Click"
msgstr "Middle Click"

#: docking/ui/settings.py:794
msgid "Choose what happens when clicking an app with the middle mouse button."
msgstr ""
"Elija qué sucede al hacer clic en una aplicación con el botón central del "
"mouse."

#: docking/ui/settings.py:799
msgid "Window List Sort"
msgstr "Ordenar lista de ventanas"

#: docking/ui/settings.py:801
msgid "Choose how open windows are ordered in app context menus."
msgstr ""
"Elija cómo se ordenan las ventanas abiertas en los menús contextuales de la "
"aplicación."

#: docking/ui/settings.py:809
msgid "Hide Mode"
msgstr "Modo de Ocultacion"

#: docking/ui/settings.py:811
msgid "Hide Delay"
msgstr "Retraso al Ocultar"

#: docking/ui/settings.py:814
msgid "Set how long the dock waits before hiding after the pointer leaves."
msgstr ""
"Establezca cuánto tiempo espera la base antes de ocultarse después de que se "
"vaya el puntero."

#: docking/ui/settings.py:819
msgid "Unhide Delay"
msgstr "Retraso al Mostrar"

#: docking/ui/settings.py:822
msgid "Set how long the dock waits before showing after the pointer returns."
msgstr ""
"Establezca cuánto tiempo espera la base antes de mostrarse después de que "
"regresa el puntero."

#: docking/ui/settings.py:827
msgid "Pressure Reveal"
msgstr "Revelación de presión"

#: docking/ui/settings.py:830
msgid ""
"Require the pointer to push against the screen edge before revealing a "
"hidden dock."
msgstr ""
"Solicite que el puntero empuje contra el borde de la pantalla antes de "
"revelar una base oculta."

#: docking/ui/settings.py:834
msgid "Pressure Threshold"
msgstr "Umbral de presión"

#: docking/ui/settings.py:836
msgid "Show Startup Tips"
msgstr "Mostrar consejos de inicio"

#: docking/ui/settings.py:839
msgid ""
"Show one Docking usage tip after startup, unless a higher-priority startup "
"notification is visible."
msgstr ""
"Muestra un consejo de uso del Docking después del inicio, a menos que esté "
"visible una notificación de inicio de mayor prioridad."

#: docking/ui/settings.py:847
msgid "Stacks"
msgstr "Pilas"

#: docking/ui/settings.py:850
msgid "Open On"
msgstr "Open On"

#: docking/ui/settings.py:852
msgid "Choose whether stacks open on click or while hovering."
msgstr "Elige si las pilas se abren al hacer clic o al pasar el cursor."

#: docking/ui/settings.py:858
msgid "Recent Apps"
msgstr "Aplicaciones recientes"

#: docking/ui/settings.py:861
msgid "Show Recently Used Apps"
msgstr "Mostrar aplicaciones utilizadas recientemente"

#: docking/ui/settings.py:864
msgid "Show recently closed apps between pinned launchers and running apps."
msgstr ""
"Muestra aplicaciones cerradas recientemente entre lanzadores anclados y "
"aplicaciones en ejecución."

#: docking/ui/settings.py:869
msgid "Number of Recent Apps"
msgstr "Número de aplicaciones recientes"

#: docking/ui/settings.py:871
msgid "Maximum recently used app icons to display."
msgstr ""
"Número máximo de iconos de aplicaciones utilizados recientemente para "
"mostrar."

#: docking/ui/settings.py:874
msgid "Keep Recent Apps For"
msgstr "Mantener aplicaciones recientes para"

#: docking/ui/settings.py:876
msgid "Remove recent apps after this many days of inactivity."
msgstr ""
"Elimina las aplicaciones recientes después de tantos días de inactividad."

#: docking/ui/settings.py:885
msgid "Show Recent Documents"
msgstr "Mostrar documentos recientes"

#: docking/ui/settings.py:888
msgid "Show a \"Recent Documents\" submenu when right-clicking an app icon."
msgstr ""
"Muestra un submenú \\\"Documentos recientes\\\" al hacer clic con el botón "
"derecho en el icono de una aplicación."

#: docking/ui/settings.py:893
msgid "Max Documents Per App"
msgstr "Máximo de documentos por aplicación"

#: docking/ui/settings.py:895
msgid "Maximum recent document entries shown per app."
msgstr "Entradas máximas de documentos recientes mostradas por aplicación."

#: docking/ui/settings.py:901
msgid "Global Search"
msgstr "Búsqueda global"

#: docking/ui/settings.py:906
msgid "Enable Docking's process-wide search palette."
msgstr "Activa la paleta de búsqueda global del proceso de Docking."

#: docking/ui/settings.py:909
msgid "Preferred Shortcut"
msgstr "Atajo preferido"

#: docking/ui/settings.py:912
msgid ""
"Click the button, then press the desired key sequence. The desktop may "
"reserve some shortcuts."
msgstr "Haz clic en el botón y pulsa la combinación de teclas deseada. Es "
