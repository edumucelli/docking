#: docking/ui/settings.py:402
msgid ""
"When Follow Cursor is enabled, the dock follows the pointer across monitors. "
"The selected monitor is kept as the fallback."
msgstr ""
"Lorsque Suivre le curseur est activé, la station d'accueil suit le pointeur "
"sur les moniteurs. Le moniteur sélectionné est conservé comme solution de "
"repli."

#: docking/ui/settings.py:448
msgid "Added on top of the theme's own distance from the edge."
msgstr "Ajouté en plus de la distance du thème par rapport au bord."

#: docking/ui/settings.py:488
msgid ""
"Pixels of cursor pressure against the edge required to reveal a hidden dock. "
"Higher values mean the dock will not reveal as easily."
msgstr ""
"Pixels de pression du curseur contre le bord requis pour révéler un quai "
"caché. Des valeurs plus élevées signifient que le dock ne se révélera pas "
"aussi facilement."

#: docking/ui/settings.py:510
msgid "Look"
msgstr "Aspect"

#: docking/ui/settings.py:512
msgid "Theme"
msgstr "Theme"

#: docking/ui/settings.py:512
msgid "Choose the dock color palette."
msgstr "Choisissez la palette de couleurs du dock."

#: docking/ui/settings.py:514
msgid "Icon Size"
msgstr "Taille des Icônes"

#: docking/ui/settings.py:516
msgid "Set the base size of dock icons before zoom is applied."
msgstr ""
"Définissez la taille de base des icônes du Dock avant d'appliquer le zoom."

#: docking/ui/settings.py:519
msgid "Transparency"
msgstr "Transparency"

#: docking/ui/settings.py:521
msgid "Adjust how transparent the dock background is."
msgstr "Ajustez le degré de transparence de l'arrière-plan du dock."

#: docking/ui/settings.py:524
msgid "Zoom"
msgstr "Zoom"

#: docking/ui/settings.py:526
msgid "Enlarge icons when the pointer hovers over the dock."
msgstr "Agrandissez les icônes lorsque le pointeur passe sur le dock."

#: docking/ui/settings.py:529
msgid "Zoom Percent"
msgstr "Pourcentage de zoom"

#: docking/ui/settings.py:531
msgid "Set how much hovered icons grow when zoom is enabled."
msgstr "Définissez la taille des icônes survolées lorsque le zoom est activé."

#: docking/ui/settings.py:534
msgid "Show Tooltips"
msgstr "Afficher les infobulles"

#: docking/ui/settings.py:536
msgid "Show item names and details when hovering over dock items."
msgstr ""
"Afficher les noms et les détails des éléments lorsque vous survolez les "
"éléments du Dock."

#: docking/ui/settings.py:539
msgid "Window Previews"
msgstr "Aperçu des Fenêtres"

#: docking/ui/settings.py:541
msgid "Show window thumbnails when hovering over running apps."
msgstr ""
"Afficher les vignettes des fenêtres lorsque vous survolez les applications "
"en cours d'exécution."

#: docking/ui/settings.py:544
msgid "Show Window Counts"
msgstr "Afficher le nombre de fenêtres"

#: docking/ui/settings.py:547
msgid "Show a number on running app indicators when multiple windows are open."
msgstr ""
"Afficher un numéro sur les indicateurs d'application en cours d'exécution "
"lorsque plusieurs fenêtres sont ouvertes."

#: docking/ui/settings.py:555
msgid "Placement"
msgstr "Placement"

#: docking/ui/settings.py:558
msgid "Position"
msgstr "Position"

#: docking/ui/settings.py:560
msgid "Choose which screen edge the dock uses."
msgstr "Choisissez le bord de l'écran utilisé par la station d'accueil."

#: docking/ui/settings.py:562
msgid "Extra Distance from Edge"
msgstr "Distance supplémentaire du bord"

#: docking/ui/settings.py:564
msgid "Current Workspace Only"
msgstr "Espace de travail actuel uniquement"

#: docking/ui/settings.py:567
msgid "Show running windows only from the active workspace when supported."
msgstr ""
"Afficher les fenêtres en cours d'exécution uniquement à partir de l'espace "
"de travail actif lorsqu'elles sont prises en charge."

#: docking/ui/settings.py:575 docking/ui/settings.py:585
msgid "Monitor"
msgstr "Moniteur"

#: docking/ui/settings.py:578
msgid "Follow Cursor"
msgstr "Suivre le curseur"

#: docking/ui/settings.py:581
msgid "Move the dock to the monitor where the pointer is currently located."
msgstr ""
"Déplacez le dock vers le moniteur où se trouve actuellement le pointeur."

#: docking/ui/settings.py:590
msgid "Layout"
msgstr "Disposition"

#: docking/ui/settings.py:593
msgid "Lock Positions"
msgstr "Verrouiller les positions"

#: docking/ui/settings.py:596
msgid "Prevent dock items from being reordered or removed by drag and drop."
msgstr ""
"Empêchez la réorganisation ou la suppression des éléments du Dock par "
"glisser-déposer."

#: docking/ui/settings.py:601
msgid "Anchor Applets to End"
msgstr "Ancrer les applets à la fin"

#: docking/ui/settings.py:603
msgid "Keep applets grouped at the end of the dock."
msgstr "Gardez les applets regroupés à la fin du dock."

#: docking/ui/settings.py:606
msgid "Anchor Files to End"
msgstr "Ancrer les fichiers a la fin"

#: docking/ui/settings.py:608
msgid "Keep pinned files and folders grouped at the end of the dock."
msgstr ""
"Conservez les fichiers et dossiers épinglés regroupés à la fin du dock."

#: docking/ui/settings.py:647
msgid "Left Click"
msgstr "Left Click"

#: docking/ui/settings.py:650
msgid ""
"Choose what happens when clicking a running app with the left mouse button."
msgstr ""
"Choisissez ce qui se passe lorsque vous cliquez sur une application en cours "
"d'exécution avec le bouton gauche de la souris."

#: docking/ui/settings.py:655
msgid "Middle Click"
msgstr "Middle Click"

#: docking/ui/settings.py:658
msgid "Choose what happens when clicking an app with the middle mouse button."
msgstr ""
"Choisissez ce qui se passe lorsque vous cliquez sur une application avec le "
"bouton central de la souris."

#: docking/ui/settings.py:663
msgid "Window List Sort"
msgstr "Tri de la liste des fenêtres"

#: docking/ui/settings.py:665
msgid "Choose how open windows are ordered in app context menus."
msgstr ""
"Choisissez comment les fenêtres ouvertes sont classées dans les menus "
"contextuels de l'application."

#: docking/ui/settings.py:673
msgid "Hide Mode"
msgstr "Mode de masquage"

#: docking/ui/settings.py:675
msgid "Hide Delay"
msgstr "Delai de masquage"

#: docking/ui/settings.py:678
msgid "Set how long the dock waits before hiding after the pointer leaves."
msgstr ""
"Définissez la durée pendant laquelle le dock attend avant de se cacher après "
"le départ du pointeur."

#: docking/ui/settings.py:683
msgid "Unhide Delay"
msgstr "Delai d'apparition"

#: docking/ui/settings.py:686
msgid "Set how long the dock waits before showing after the pointer returns."
msgstr ""
"Définissez le temps d'attente du dock avant de s'afficher après le retour du "
"pointeur."

#: docking/ui/settings.py:691
msgid "Pressure Reveal"
msgstr "Révélation de pression"

#: docking/ui/settings.py:694
msgid ""
"Require the pointer to push against the screen edge before revealing a "
"hidden dock."
msgstr ""
"Exigez que le pointeur pousse contre le bord de l’écran avant de révéler un "
"dock caché."

#: docking/ui/settings.py:698
msgid "Pressure Threshold"
msgstr "Seuil de pression"

#: docking/ui/settings.py:700
msgid "Show Startup Tips"
msgstr "Afficher les conseils de démarrage"

#: docking/ui/settings.py:703
msgid ""
"Show one Docking usage tip after startup, unless a higher-priority startup "
"notification is visible."
msgstr ""
"Afficher un conseil d'utilisation de Docking après le démarrage, sauf si une "
"notification de démarrage de priorité plus élevée est visible."

#: docking/ui/settings.py:711
msgid "Folder Stacks"
msgstr "Folder Stacks"

#: docking/ui/settings.py:714
msgid "Open On"
msgstr "Open On"

#: docking/ui/settings.py:716
msgid "Choose whether folder stacks open on click or while hovering."
msgstr "Choisissez si les piles de dossiers s'ouvrent au clic ou au survol."

#: docking/ui/settings.py:722
msgid "Recent Apps"
msgstr "Applications récentes"

#: docking/ui/settings.py:725
msgid "Show Recently Used Apps"
msgstr "Afficher les applications récemment utilisées"

#: docking/ui/settings.py:728
msgid "Show recently closed apps between pinned launchers and running apps."
msgstr ""
"Afficher les applications récemment fermées entre les lanceurs épinglés et "
"les applications en cours d'exécution."

#: docking/ui/settings.py:733
msgid "Number of Recent Apps"
msgstr "Nombre d'applications récentes"

#: docking/ui/settings.py:735
msgid "Maximum recently used app icons to display."
msgstr "Nombre maximal d'icônes d'applications récemment utilisées à afficher."

#: docking/ui/settings.py:738
msgid "Keep Recent Apps For"
msgstr "Conserver les applications récentes pour"

#: docking/ui/settings.py:740
msgid "Remove recent apps after this many days of inactivity."
msgstr ""
"Supprimez les applications récentes après plusieurs jours d'inactivité."

#: docking/ui/settings.py:749
msgid "Show Recent Documents"
msgstr "Afficher les documents récents"

#: docking/ui/settings.py:752
msgid "Show a \"Recent Documents\" submenu when right-clicking an app icon."
msgstr ""
"Afficher un sous-menu \\\"Documents récents\\\" lorsque vous cliquez avec le "
"bouton droit sur l'icône d'une application."

#: docking/ui/settings.py:757
msgid "Max Documents Per App"
msgstr "Nombre maximum de documents par application"

#: docking/ui/settings.py:759
msgid "Maximum recent document entries shown per app."
msgstr ""
"Nombre maximal d'entrées de documents récentes affichées par application."

