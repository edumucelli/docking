msgstr ""
"Ipakita ang mga kamakailang saradong app sa pagitan ng mga naka-pin na "
"launcher at tumatakbong app."

#: docking/ui/settings.py:869
msgid "Number of Recent Apps"
msgstr "Bilang ng Kamakailang Apps"

#: docking/ui/settings.py:871
msgid "Maximum recently used app icons to display."
msgstr "Pinakamataas na kamakailang ginamit na mga icon ng app na ipapakita."

#: docking/ui/settings.py:874
msgid "Keep Recent Apps For"
msgstr "Panatilihin ang Kamakailang Apps Para sa"

#: docking/ui/settings.py:876
msgid "Remove recent apps after this many days of inactivity."
msgstr ""
"Alisin ang mga kamakailang app pagkatapos nitong maraming araw ng kawalan ng "
"aktibidad."

#: docking/ui/settings.py:885
msgid "Show Recent Documents"
msgstr "Ipakita ang Mga Kamakailang Dokumento"

