msgid "Connecting"
msgstr "በመገናኘት ላይ"

#: docking/search/controller.py:273
msgid "Denied"
msgstr "ተከልክሏል"

#: docking/search/controller.py:275
msgid "Cancelled"
msgstr "ተሰርዟል"

#: docking/search/controller.py:734
msgid "Live Window"
msgstr "ቀጥታ መስኮት"

