msgstr "በዴስክቶፕ የተመደበ"

#: docking/search/controller.py:238
msgid "Unavailable on this desktop"
msgstr "በዚህ ዴስክቶፕ ላይ አይገኝም"

#: docking/search/controller.py:240
msgid "Permission denied"
msgstr "ፈቃድ ተከልክሏል"

#: docking/search/controller.py:242
msgid "Setup cancelled"
msgstr "ማዋቀር ተሰርዟል"

#: docking/search/controller.py:254
msgid "Conflict"
msgstr "ግጭት"

#: docking/search/controller.py:255 docking/search/controller.py:277
msgid "Failed"
msgstr "አልተሳካም"

#: docking/search/controller.py:258 docking/search/controller.py:278
msgid "Inactive"
