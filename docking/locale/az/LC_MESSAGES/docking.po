msgid "Left Click"
msgstr "Left Click"

#: docking/ui/settings.py:786
msgid ""
"Choose what happens when clicking a running app with the left mouse button."
msgstr ""
"Sol siçan düyməsi ilə işləyən proqrama kliklədikdə nə baş verəcəyini seçin."

#: docking/ui/settings.py:791
msgid "Middle Click"
msgstr "Middle Click"

#: docking/ui/settings.py:794
msgid "Choose what happens when clicking an app with the middle mouse button."
msgstr "Siçanın orta düyməsi ilə proqrama kliklədikdə nə baş verəcəyini seçin."

