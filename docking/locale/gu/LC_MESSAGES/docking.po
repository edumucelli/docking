#, python-brace-format
msgid "{date}: {temp_range}"
msgstr "{date}: {temp_range}"

#: docking/applets/weather/state.py:153
#, python-brace-format
msgid "{city}: {temp}"
msgstr "{city}: {temp}"

#: docking/applets/windowkiller/applet.py:78
msgid "Window Killer"
msgstr "વિન્ડો કિલર"

#: docking/applets/windowkiller/applet.py:94
msgid "Click, then select a window to kill"
msgstr "ક્લિક કરો, પછી બંધ કરવા માટે વિન્ડો પસંદ કરો"

#: docking/applets/workspaces/applet.py:54
msgid "Workspaces"
msgstr "Workspaces"

#: docking/core/tips.py:57
msgid "Open the dock menu from anywhere"
msgstr "ગમે ત્યાંથી ડોક મેનૂ ખોલો"

#: docking/core/tips.py:59
msgid ""
"Hold Ctrl and right-click anywhere on the shelf to open the dock menu. This "
"is the quickest path to Preferences, Applets, Diagnostics, and Quit when "
"there is no empty space near the icons."
msgstr ""
"Ctrl ને પકડી રાખો અને ડોક મેનૂ ખોલવા માટે શેલ્ફ પર ગમે ત્યાં જમણું-ક્લિક કરો. જ્યારે "
"ચિહ્નોની નજીક કોઈ ખાલી જગ્યા ન હોય ત્યારે પસંદગીઓ, એપલેટ્સ, ડાયગ્નોસ્ટિક્સ અને છોડવાનો "
"આ સૌથી ઝડપી રસ્તો છે."

#: docking/core/tips.py:67
msgid "Start with Preferences"
msgstr "પસંદગીઓ સાથે પ્રારંભ કરો"

#: docking/core/tips.py:69
msgid ""
"Use Preferences to adjust position, monitor behavior, icon size, zoom, "
"hiding, themes, previews, tooltips, and click actions. It is the best first "
"stop when the dock does not feel quite right."
msgstr ""
"પોઝિશન, મોનિટર વર્તણૂક, આયકનનું કદ, ઝૂમ, છુપાવવા, થીમ્સ, પૂર્વાવલોકનો, ટૂલટિપ્સ અને ક્લિક "
"ક્રિયાઓ ગોઠવવા માટે પસંદગીઓનો ઉપયોગ કરો. જ્યારે ડોક એકદમ યોગ્ય ન લાગે ત્યારે તે શ્રેષ્ઠ "
"પ્રથમ સ્ટોપ છે."

#: docking/core/tips.py:76
msgid "Add applets from the dock menu"
msgstr "ડોક મેનૂમાંથી એપ્લેટ ઉમેરો"

#: docking/core/tips.py:78
msgid ""
"Right-click the shelf background and choose Add Applet to add launchers, "
"system status, media controls, productivity helpers, and small utility tools "
"directly to the dock."
msgstr ""
"શેલ્ફ પૃષ્ઠભૂમિ પર જમણું-ક્લિક કરો અને લોંચર્સ, સિસ્ટમ સ્થિતિ, મીડિયા નિયંત્રણો, ઉત્પાદકતા "
"સહાયકો અને નાના ઉપયોગિતા સાધનોને સીધા જ ડોકમાં ઉમેરવા માટે ઍપ્લેટ ઉમેરો પસંદ કરો."

#: docking/core/tips.py:85
msgid "Use separators for organization"
msgstr "સંસ્થા માટે વિભાજકનો ઉપયોગ કરો"

#: docking/core/tips.py:87
msgid ""
"Right-click where a divider should go and choose Add Separator. Separators "
"make it easier to keep pinned apps, folders, and applets in clear groups."
msgstr ""
"જ્યાં વિભાજક જવું જોઈએ ત્યાં જમણું-ક્લિક કરો અને વિભાજક ઉમેરો પસંદ કરો. વિભાજકો પિન કરેલ "
"એપ્લિકેશન્સ, ફોલ્ડર્સ અને એપ્લેટ્સને સ્પષ્ટ જૂથોમાં રાખવાનું સરળ બનાવે છે."

#: docking/core/tips.py:94
msgid "Pin running apps"
msgstr "ચાલી રહેલ એપ્લિકેશનોને પિન કરો"

#: docking/core/tips.py:96
msgid ""
"Right-click a running app and choose Keep in Dock. The launcher will stay "
"available after the app closes, so you can start it again with one click."
msgstr ""
"ચાલી રહેલ એપ પર જમણું-ક્લિક કરો અને Keep in Dock પસંદ કરો. એપ્લિકેશન બંધ થયા પછી "
"લોન્ચર ઉપલબ્ધ રહેશે, જેથી તમે તેને એક ક્લિકથી ફરી શરૂ કરી શકો."

#: docking/core/tips.py:103
msgid "Remove pinned items quickly"
msgstr "પિન કરેલી વસ્તુઓને ઝડપથી દૂર કરો"

#: docking/core/tips.py:105
msgid ""
"Right-click a pinned item and choose Remove from Dock, or drag unlocked "
"items off the dock. Removing a launcher does not uninstall the application "
"or delete your files."
msgstr ""
"પિન કરેલી આઇટમ પર રાઇટ-ક્લિક કરો અને ડોકમાંથી દૂર કરો પસંદ કરો અથવા અનલૉક કરેલી "
"આઇટમને ડૉકની બહાર ખેંચો. લૉન્ચરને દૂર કરવાથી એપ્લિકેશન અનઇન્સ્ટોલ થતી નથી અથવા તમારી "
"ફાઇલો કાઢી શકાતી નથી."

#: docking/core/tips.py:112
msgid "Drop items onto the dock"
msgstr "વસ્તુઓને ડોક પર મૂકો"

#: docking/core/tips.py:114
msgid ""
"Drag applications, .desktop files, files, folders, and AppImages onto "
"Docking to pin them. Dropped folders become folder stacks, and dropped "
"AppImages can get their own launcher."
msgstr ""
"એપ્લિકેશન્સ, .ડેસ્કટોપ ફાઇલો, ફાઇલો, ફોલ્ડર્સ અને AppImages ને પિન કરવા માટે તેને ડોકિંગ "
"પર ખેંચો. ડ્રોપ કરેલા ફોલ્ડર્સ ફોલ્ડર સ્ટેક્સ બની જાય છે, અને ડ્રોપ કરેલ AppImages પોતાનું "
"લોન્ચર મેળવી શકે છે."

#: docking/core/tips.py:121
msgid "Open files with dock apps"
msgstr "ડોક એપ્લિકેશન્સ સાથે ફાઇલો ખોલો"

#: docking/core/tips.py:123
msgid ""
"Drag a file onto an application icon to open it with that app. This is "
"useful when the file manager would otherwise choose the wrong default "
"application."
msgstr ""
"ફાઇલને તે એપ્લિકેશન સાથે ખોલવા માટે તેને એપ્લિકેશન આઇકોન પર ખેંચો. આ ઉપયોગી છે જ્યારે ફાઇલ "
"મેનેજર અન્યથા ખોટી ડિફોલ્ટ એપ્લિકેશન પસંદ કરશે."

#: docking/core/tips.py:130
msgid "Use folder stacks"
msgstr "ફોલ્ડર સ્ટેક્સનો ઉપયોગ કરો"

#: docking/core/tips.py:132
msgid ""
"Pin a folder and click it from the dock to browse its contents without "
"opening a file manager first. It works well for common places like "
"Downloads, Projects, and screenshots."
msgstr ""
"ફોલ્ડરને પિન કરો અને પહેલા ફાઇલ મેનેજરને ખોલ્યા વિના તેની સામગ્રીઓ બ્રાઉઝ કરવા માટે તેને "
"ડોકમાંથી ક્લિક કરો. તે ડાઉનલોડ્સ, પ્રોજેક્ટ્સ અને સ્ક્રીનશૉટ્સ જેવા સામાન્ય સ્થાનો માટે સારી "
"રીતે કાર્ય કરે છે."

#: docking/core/tips.py:139
msgid "Tune folder stack behavior"
msgstr "ફોલ્ડર સ્ટેક વર્તનને ટ્યુન કરો"

#: docking/core/tips.py:141
msgid ""
"Right-click a pinned folder to sort contents, show hidden files, or "
"customize its icon. These options let each stack behave like the folder it "
"represents."
msgstr ""
"સામગ્રીને સૉર્ટ કરવા, છુપાયેલી ફાઇલો બતાવવા અથવા તેના આઇકનને કસ્ટમાઇઝ કરવા માટે પિન "
"કરેલા ફોલ્ડર પર રાઇટ-ક્લિક કરો. આ વિકલ્પો દરેક સ્ટેકને તે રજૂ કરે છે તે ફોલ્ડરની જેમ વર્તે છે."

#: docking/core/tips.py:148
msgid "Customize pinned icons"
msgstr "પિન કરેલા ચિહ્નોને કસ્ટમાઇઝ કરો"

#: docking/core/tips.py:150
msgid ""
"Right-click a pinned app, file, or folder and use Icon -> Choose From File. "
"Custom icons are stored in Docking's config, so the original desktop file or "
"file on disk is left untouched."
msgstr ""
"પિન કરેલ એપ્લિકેશન, ફાઇલ અથવા ફોલ્ડર પર રાઇટ-ક્લિક કરો અને આઇકનનો ઉપયોગ કરો -> "
"ફાઇલમાંથી પસંદ કરો. વૈવિધ્યપૂર્ણ ચિહ્નો ડૉકિંગની રૂપરેખામાં સંગ્રહિત થાય છે, તેથી મૂળ ડેસ્કટોપ "
"ફાઇલ અથવા ડિસ્ક પરની ફાઇલ અસ્પૃશ્ય રહે છે."

#: docking/core/tips.py:157
msgid "Use the Applications applet search"
msgstr "એપ્લિકેશન એપ્લેટ શોધનો ઉપયોગ કરો"

#: docking/core/tips.py:159
msgid ""
"Add the Applications applet, open it, and type to filter installed apps. It "
"gives you a compact launcher menu without leaving the dock."
msgstr ""
"એપ્લિકેશન એપ્લેટ ઉમેરો, તેને ખોલો અને ઇન્સ્ટોલ કરેલ એપ્લિકેશન્સને ફિલ્ટર કરવા માટે ટાઇપ કરો. "
"તે તમને ડોક છોડ્યા વિના કોમ્પેક્ટ લોન્ચર મેનૂ આપે છે."

#: docking/core/tips.py:166
msgid "Use Run Application like Alt+F2"
msgstr "Alt+F2 જેવી રન એપ્લિકેશનનો ઉપયોગ કરો"

#: docking/core/tips.py:168
msgid ""
"Add Run Application to launch commands, apps, and terminal commands from the "
"dock. As you type, matching applications are shown so you can launch by name "
"or run a standalone command."
msgstr ""
"ડોકમાંથી આદેશો, એપ્લિકેશનો અને ટર્મિનલ આદેશો શરૂ કરવા માટે એપ્લિકેશન ચલાવો ઉમેરો. જેમ જેમ "
"તમે ટાઇપ કરો છો તેમ, મેળ ખાતી એપ્લિકેશનો બતાવવામાં આવે છે જેથી કરીને તમે નામ દ્વારા લોંચ "
"કરી શકો અથવા એકલ આદેશ ચલાવી શકો."

#: docking/core/tips.py:175
msgid "Use window previews"
msgstr "વિન્ડો પૂર્વાવલોકનો ઉપયોગ કરો"

#: docking/core/tips.py:177
msgid ""
"Hover running apps to inspect open windows before switching. Previews help "
"when one application has several windows open."
msgstr ""
"સ્વિચ કરતા પહેલા ખુલ્લી વિન્ડોની તપાસ કરવા માટે ચાલી રહેલ એપને હોવર કરો. જ્યારે એક "
"એપ્લિકેશનમાં ઘણી વિન્ડો ખુલ્લી હોય ત્યારે પૂર્વાવલોકનો મદદ કરે છે."

#: docking/core/tips.py:183
msgid "Choose your click behavior"
msgstr "તમારું ક્લિક વર્તન પસંદ કરો"

#: docking/core/tips.py:185
msgid ""
"Preferences -> Behavior lets left click toggle, cycle, or focus the most "
"recent window. Pick the behavior that matches how you switch between running "
"applications."
msgstr ""
"પસંદગીઓ -> વર્તણૂક ડાબું ક્લિક ટૉગલ, સાયકલ અથવા સૌથી તાજેતરની વિન્ડોને ફોકસ કરવા દે છે. "
"તમે ચાલી રહેલ એપ્લિકેશનો વચ્ચે કેવી રીતે સ્વિચ કરો છો તેની સાથે મેળ ખાતું વર્તન પસંદ કરો."

#: docking/core/tips.py:192
msgid "Ctrl-click opens a new window"
msgstr "Ctrl-ક્લિક નવી વિન્ડો ખોલે છે"

#: docking/core/tips.py:194
msgid ""
"Hold Ctrl while clicking an app icon to launch another window. This works "
"even when the app is already running and a normal click would focus it."
msgstr ""
"બીજી વિન્ડો લોંચ કરવા માટે એપ્લિકેશન આયકન પર ક્લિક કરતી વખતે Ctrl દબાવી રાખો. આ એપ "
"પહેલેથી જ ચાલી રહી હોય ત્યારે પણ કામ કરે છે અને એક સામાન્ય ક્લિક તેને ફોકસ કરશે."

#: docking/core/tips.py:201
msgid "Use app right-click menus"
msgstr "એપ્લિકેશન રાઇટ-ક્લિક મેનૂનો ઉપયોગ કરો"

#: docking/core/tips.py:203
msgid ""
"Right-click apps for desktop actions, open windows, recent documents, "
"pinning, and close actions. Many apps expose useful shortcuts there, such as "
"opening a private window or composing a new message."
msgstr ""
"ડેસ્કટૉપ ક્રિયાઓ, ઓપન વિન્ડોઝ, તાજેતરના દસ્તાવેજો, પિનિંગ અને બંધ ક્રિયાઓ માટે એપ્સ પર "
"રાઇટ-ક્લિક કરો. ઘણી એપ્લિકેશનો ત્યાં ઉપયોગી શૉર્ટકટ્સ ઉજાગર કરે છે, જેમ કે ખાનગી વિંડો "
"ખોલવી અથવા નવો સંદેશ લખવો."

#: docking/core/tips.py:211
msgid "Use Recent Files"
msgstr "તાજેતરની ફાઇલોનો ઉપયોગ કરો"

#: docking/core/tips.py:213
msgid ""
"Add the Recent Files applet to jump back into documents you used recently. "
"It is a faster path when you remember the file, not the folder."
msgstr ""
"તમે તાજેતરમાં ઉપયોગમાં લીધેલા દસ્તાવેજોમાં પાછા જવા માટે તાજેતરની ફાઇલ્સ એપ્લેટ ઉમેરો. "
"જ્યારે તમે ફાઇલને યાદ રાખો છો ત્યારે તે ઝડપી પાથ છે, ફોલ્ડરને નહીં."

#: docking/core/tips.py:220
msgid "Use System Tray when needed"
msgstr "જ્યારે જરૂર પડે ત્યારે સિસ્ટમ ટ્રેનો ઉપયોગ કરો"

#: docking/core/tips.py:222
msgid ""
"Add System Tray for tray/status apps and use its menu to manage tray "
"ownership when supported. This helps with legacy apps that still rely on a "
"classic notification area."
msgstr ""
"ટ્રે/સ્ટેટસ એપ્લિકેશન્સ માટે સિસ્ટમ ટ્રે ઉમેરો અને જ્યારે સપોર્ટેડ હોય ત્યારે ટ્રે માલિકીનું સંચાલન "
