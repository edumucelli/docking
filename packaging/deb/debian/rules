#!/usr/bin/make -f

export PYBUILD_NAME=docking
export PYBUILD_SYSTEM=pyproject

RELEASE_BUILD := $(filter pkg.docking.release,$(DEB_BUILD_PROFILES))
ifeq ($(RELEASE_BUILD),)
WHEEL_BUILD_FLAGS := --no-isolation
endif

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_build:
	# Build only the isolated wheel used by override_dh_auto_install.
	:

override_dh_install:
	dh_install
	# Optional app icons (hicolor theme). If present in source tree,
	# copy into package so Icon=org.docking.Docking resolves from desktop environments.
	if [ -d packaging/deb/icons/hicolor ]; then \
		mkdir -p debian/docking/usr/share/icons/hicolor; \
		cp -a packaging/deb/icons/hicolor/. debian/docking/usr/share/icons/hicolor/; \
	fi

override_dh_auto_test:
	# Tests require pytest and dev deps; run in CI instead

override_dh_auto_install:
	# Compile gettext catalogs so packaged installs include .mo files.
	bash tools/i18n.sh --compile
	# Install Docking into a private path so the package depends on generic
	# python3 (>= 3.10) instead of the builder's default Python minor version.
	mkdir -p debian/docking/usr/lib/docking/python
ifneq ($(wildcard debian/ppa-wayland),)
	# Jammy's setuptools cannot build a wheel from the project's PEP 621 metadata.
	cp -a docking debian/docking/usr/lib/docking/python/
else
	wheel_dir="$$(mktemp -d)" && trap 'rm -rf "$$wheel_dir"' EXIT && \
		python3 -m build --wheel $(WHEEL_BUILD_FLAGS) --outdir "$$wheel_dir" && \
		python3 -m pip install --no-index --no-compile --no-deps \
			--target=debian/docking/usr/lib/docking/python "$$wheel_dir"/docking-*.whl
	rm -rf debian/docking/usr/lib/docking/python/*.dist-info
	rm -rf debian/docking/usr/lib/docking/python/bin
endif
	mkdir -p debian/docking/usr/bin
	install -m 0755 packaging/deb/docking debian/docking/usr/bin/docking
	install -m 0755 packaging/shared/docking-camshield-helper debian/docking/usr/bin/docking-camshield-helper
ifneq ($(RELEASE_BUILD),)
	# PyWayland ships CPython-specific native glue. Keep it in a Python-version
	# scoped vendor path so the package can still run on newer hosts that use
	# distro python3-pywayland instead of this fallback.
	py_minor="$$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')" ; \
	python3 -m pip install --no-compile \
		--target="debian/docking/usr/lib/docking/vendor-python$${py_minor}" \
		"pywayland>=0.4.18,<0.5"
	rm -rf debian/docking/usr/lib/docking/vendor-python*/bin
	# CI supplies native fallbacks for all supported Python versions on each architecture.
	if [ -n "$(DOCKING_EXTRA_PYWAYLAND)" ]; then \
		cp -a "$(DOCKING_EXTRA_PYWAYLAND)"/. debian/docking/usr/lib/docking/; \
		find debian/docking/usr/lib/docking -name .complete -delete; \
	fi
else
	# Ubuntu's PyWayland omits the newer protocol modules used by Docking.
	set -e; \
		py_minor="$$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"; \
		vendor="debian/docking/usr/lib/docking/vendor-python$$py_minor"; \
		mkdir -p "$$vendor"; \
		if [ -d debian/ppa-wayland ]; then \
			backport="$(CURDIR)/debian/ppa-wayland"; \
			ffi_dir="$$(mktemp -d)"; \
			trap 'rm -rf "$$ffi_dir"' EXIT; \
			(cd "$$ffi_dir" && python3 "$$backport/pywayland/ffi_build.py"); \
			cp -a "$$backport/pywayland" "$$vendor/"; \
			cp "$$ffi_dir"/pywayland/_ffi*.so "$$vendor/pywayland/"; \
			cp "$$backport/LICENSE" "$$vendor/pywayland-COPYRIGHT"; \
			protocols="$$backport/protocols"; \
		else \
			cp -a /usr/lib/python3/dist-packages/pywayland "$$vendor/"; \
			cp -L /usr/share/doc/python3-pywayland/copyright "$$vendor/pywayland-COPYRIGHT"; \
			protocols=/usr/share/wayland-protocols; \
		fi; \
		find "$$vendor/pywayland" -type d -name __pycache__ -prune -exec rm -rf {} +; \
		PYTHONPATH="$$vendor" PYTHONDONTWRITEBYTECODE=1 python3 -m pywayland.scanner \
			-o "$$vendor/pywayland/protocol" -i \
			/usr/share/wayland/wayland.xml \
			"$$protocols"/staging/ext-foreign-toplevel-list/*.xml \
			"$$protocols"/staging/ext-idle-notify/*.xml \
			"$$protocols"/staging/ext-image-capture-source/*.xml \
			"$$protocols"/staging/ext-image-copy-capture/*.xml
endif

override_dh_python3:
	# Docking installs into private paths under /usr/lib/docking and uses an
	# explicit python3 (>= 3.10) dependency in debian/control.
	:

override_dh_dwz:
	dh_dwz -Xvendor-python

override_dh_strip:
	dh_strip -Xvendor-python

override_dh_shlibdeps:
	dh_shlibdeps -Xvendor-python

override_dh_builddeb:
	# Use xz instead of newer zstd-compressed .deb members so release artifacts
	# remain installable with older dpkg versions still found on supported hosts.
	dh_builddeb -- -Zxz
