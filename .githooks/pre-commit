#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

python=.venv/bin/python
ruff_paths=(docking/ tests/ tools/bsd/ tools/windows/ tools/linux/visual_vm.py packaging/bsd/ setup.py)

echo "Checking Ruff formatting and lint..."
"$python" -m ruff format --check "${ruff_paths[@]}"
"$python" -m ruff check "${ruff_paths[@]}"
echo "Checking types and dead code..."
"$python" -m ty check --error-on-warning docking/
"$python" -m vulture --config pyproject.toml
echo "Checking translations and package data..."
bash tools/i18n.sh --check-pot-sync
bash tools/i18n.sh --check-catalogs --allow-incomplete
"$python" tools/check_package_data_sync.py
"$python" tools/check_translation_packaging.py
echo "Running tests..."
"$python" -m pytest tests/ -q
echo "Running isolated no-GI smoke tests..."
"$python" -m pytest tests/smoke/test_python314_smoke.py -q
