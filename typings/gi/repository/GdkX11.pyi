"""GTK 3 X11 APIs used by Docking; upstream GdkX11 stubs target GTK 4."""

from gi.repository import Gdk

class X11Display(Gdk.Display):
    def error_trap_push(self) -> None: ...
    def error_trap_pop(self) -> int: ...
    def error_trap_pop_ignored(self) -> None: ...
    def get_xdisplay(self) -> object: ...
    def get_default_screen(self) -> X11Screen: ...

class X11Screen(Gdk.Screen):
    def get_root_window(self) -> X11Window: ...

class X11Window(Gdk.Window):
    @staticmethod
    def foreign_new_for_display(
        display: X11Display, window: int
    ) -> X11Window | None: ...
    def get_xid(self) -> int: ...

class X11Visual(Gdk.Visual):
    def get_xvisual(self) -> object: ...

def x11_get_server_time(window: Gdk.Window) -> int: ...
